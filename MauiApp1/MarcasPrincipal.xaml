<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SysVeiculosApp.MarcasPrincipal"
             Title=":: MARCAS ::..">

    <Grid Padding="15" RowSpacing="15"
          RowDefinitions="Auto,*,Auto">

      
        <SearchBar x:Name="searchBarMarcas"
                   Grid.Row="0"
                   Placeholder="Pesquisar marca..."
                   TextChanged="SearchBarMarcas_TextChanged" />

        <CollectionView x:Name="listaMarcas"
                        Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" ColumnDefinitions="50,*,*,50,50" VerticalOptions="Center">
                        <Label Text="{Binding marid}" Grid.Column="0" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Text="{Binding marname}" Grid.Column="1" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Text="{Binding marobservacoes}" Grid.Column="2" VerticalOptions="Center" TextColor="Gray" />

                        <Button Text="✏️"
                                Grid.Column="3"
                                BackgroundColor="Transparent"
                                Clicked="OnAlterarClicked"
                                CommandParameter="{Binding}" />

                        <Button Text="🗑️"
                                Grid.Column="4"
                                BackgroundColor="Transparent"
                                Clicked="OnExcluirClicked"
                                CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        
        <Button Text="Inserir"
                Grid.Row="2"
                Clicked="BtnInserirOnClick" />
    </Grid>
</ContentPage>