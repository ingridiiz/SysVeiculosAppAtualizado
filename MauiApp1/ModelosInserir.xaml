<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SysVeiculosApp.ModelosInserir"
             Title=":: MODELO > INSERIR ::..">
    
    
    
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Nome" />
        <Entry x:Name="entNome" Placeholder="Ex.: SUV" />

        <Label Text="Observações" />
        <Entry x:Name="entObservacoes" Placeholder="Ex.: Modelo desportivo" />

        <Button Text="Salvar" Clicked="BtnSalvar_Clicked" />
        <Button Text="Voltar" Clicked="BtnVoltar_Clicked" />
    </VerticalStackLayout>
</ContentPage>