<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SysVeiculosApp.ModelosAlterar"
             Title="::: MODELO > ALTERAR :::">
    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Código" />
        <Entry x:Name="entModId" IsReadOnly="True" />

        <Label Text="Nome do Modelo" />
        <Entry x:Name="txtNomeModelo" />

        <Label Text="Observações" />
        <Entry x:Name="txtModObservacoes" />

        <Button Text="Salvar" Clicked="btnSalvarOnClick" />
        <Button Text="Voltar" Clicked="btnVoltarOnClick" />

    </VerticalStackLayout>
</ContentPage>