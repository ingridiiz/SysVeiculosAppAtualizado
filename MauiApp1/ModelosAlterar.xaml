<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SysVeiculosApp.ModelosAlterar"
             Title="Alterar Modelo">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Alterar Cadastro de Modelo"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="Nome do Modelo:" FontAttributes="Bold" />
            <Entry x:Name="txtNomeModelo" Placeholder="Digite o nome do modelo" />

            <Label Text="Marca:" FontAttributes="Bold" />
            <Entry x:Name="txtMarcaModelo" Placeholder="Digite a marca" />

            <Label Text="Observações:" FontAttributes="Bold" />
            <Entry x:Name="txtObservacoesModelo" Placeholder="Digite as observações" />

            <Button x:Name="btnSalvar" Text="Salvar" Clicked="btnSalvarOnClick" BackgroundColor="#2E7D32" TextColor="White" />
            <Button x:Name="btnVoltar" Text="Voltar" Clicked="btnVoltarOnClick" BackgroundColor="#757575" TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>