<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SysVeiculosApp.ModelosPrincipal"
             Title=":: MODELOS ::">

    <Grid Padding="15" RowSpacing="15"
          RowDefinitions="Auto,*,Auto">

        
        <SearchBar x:Name="searchBarModelos"
                   Grid.Row="0"
                   Placeholder="Pesquisar modelo..."
                   TextChanged="SearchBarModelos_TextChanged" />

       
        <CollectionView x:Name="collectionViewModelos"
                        Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" ColumnDefinitions="50,*,*,50,50">
                        <Label Text="{Binding modid}" Grid.Column="0" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Text="{Binding modnome}" Grid.Column="1" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Text="{Binding modobservacoes}" Grid.Column="2" TextColor="Gray" VerticalOptions="Center" />

                        <Button Text="✏️"
                                Grid.Column="3"
                                BackgroundColor="Transparent"
                                Clicked="BtnEditar_Clicked"
                                CommandParameter="{Binding}" />

                        <Button Text="🗑️"
                                Grid.Column="4"
                                BackgroundColor="Transparent"
                                Clicked="BtnExcluir_Clicked"
                                CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        
        <Button Text="Inserir Novo Modelo"
                Grid.Row="2"
                Clicked="BtnInserirOnClick" />
    </Grid>

</ContentPage>