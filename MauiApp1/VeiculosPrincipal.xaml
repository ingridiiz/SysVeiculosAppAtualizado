<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SysVeiculosApp.VeiculosPrincipal"
             Title="Veículos">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <CollectionView x:Name="collectionViewVeiculos"
                            HeightRequest="400"
                            SelectionMode="Single"
                            SelectionChanged="collectionViewVeiculos_SelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="White"
                                Stroke="#E0E0E0"
                                StrokeThickness="1"
                                Padding="15"
                                Margin="0,5">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="3">
                               
                                <Label Text="{Binding veinome}" FontSize="18" FontAttributes="Bold" TextColor="Black" />

                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="Fabricação:" FontSize="13" TextColor="Gray" />
                                    <Label Text="{Binding veianofabricacao}" FontSize="13" TextColor="Black" />
                                    <Label Text="• Modelo:" FontSize="13" TextColor="Gray" />
                                    <Label Text="{Binding veianomodelo}" FontSize="13" TextColor="Black" />
                                </HorizontalStackLayout>

                                
                                <Label Text="{Binding veiobservacoes}" FontSize="14" TextColor="Gray" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Inserir" Clicked="btnInserirOnClick"/>
            <Button Text="Alterar" Clicked="btnAlterar_Clicked"/>
            <Button Text="Excluir" Clicked="btnExcluir_Clicked" BackgroundColor="#D32F2F" TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>