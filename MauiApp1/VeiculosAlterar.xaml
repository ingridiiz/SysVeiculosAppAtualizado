<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SysVeiculosApp.VeiculosAlterar"
             Title=":: VEÍCULOS > ALTERAR ::..">
    
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Nome" />
        <Entry x:Name="entNome" Placeholder="Ex.: Corolla" />

        <Label Text="Ano Fabricação" />
        <Entry x:Name="entAnoFabricacao" Keyboard="Numeric" Placeholder="Ex.: 2022" />

        <Label Text="Ano Modelo" />
        <Entry x:Name="entAnoModelo" Keyboard="Numeric" Placeholder="Ex.: 2023" />

        <Label Text="Observações" />
        <Entry x:Name="entObservacoes" Placeholder="Ex.: Completo" />

        <Button Text="Salvar" Clicked="BtnSalvar_Clicked" />
        <Button Text="Voltar" Clicked="BtnVoltar_Clicked" />
    </VerticalStackLayout>
</ContentPage>